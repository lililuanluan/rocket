# syntax=docker/dockerfile:1.7

# docker的multi- stage构建，这一阶段时构建，基于ubuntu，后面就可以从这个阶段拷贝构建产物 COPY --from=builder
FROM ubuntu:22.04 AS builder

# 让apt在安装软件时不弹交互界面，自动用默认选项继续执行
ENV DEBIAN_FRONTEND=noninteractive 

# ARG是Dockerfile中的构建参数，可以在构建镜像时通过--build-arg传入值，这里定义了一个BUG_ID参数，默认值是none，可以在构建时指定为bug1或bug2来注入不同的bug
ARG BUG_ID=none

RUN apt-get update && apt-get install -y \
    git \
    cmake \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    gcc-12 \
    g++-12 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100


RUN pip3 install conan

# 使用 BuildKit 将源码目录临时挂载进构建容器，避免每次改代码都让 COPY 层失效。
# 其中 /root/.conan2 和 /opt/rippled-build 都作为持久 cache mount，这样：
# 1. Conan 依赖缓存可复用
# 2. CMake/Ninja 的 build 目录可做增量编译
# 最终只把编好的 rippled 拷出到镜像层中。
RUN --mount=type=bind,source=rippled,target=/src/rippled,readonly \
    --mount=type=cache,id=rippled-conan-cache,target=/root/.conan2,sharing=locked \
    --mount=type=cache,id=rippled-build-cache,target=/opt/rippled-build,sharing=locked \
    bash -euxo pipefail -c '\
        install_deps() { \
            conan install /src/rippled --output-folder /opt/rippled-build --build missing --settings build_type=Release \
                -c tools.build:jobs="$(nproc)"; \
        }; \
        conan profile detect --force && \
        sed -i "s|^compiler\\.cppstd=.*$|compiler.cppstd=20|" "$(conan config home)/profiles/default" && \
        sed -i "s|^compiler\\.libcxx=.*$|compiler.libcxx=libstdc++11|" "$(conan config home)/profiles/default" && \
        conan remote add --index 0 xrplf "https://conan.ripplex.io" || true && \
        install_deps || { \
            echo "conan install failed; clearing cached recipes and retrying once" >&2; \
            rm -rf /root/.conan2/p /root/.conan2/t /opt/rippled-build/* && \
            install_deps; \
        } && \
        cmake -S /src/rippled -B /opt/rippled-build \
            -DCMAKE_TOOLCHAIN_FILE:FILEPATH=/opt/rippled-build/build/generators/conan_toolchain.cmake \
            -DCMAKE_BUILD_TYPE=Release \
            -Dxrpld=ON \
            -Dtests=OFF \
            -DCMAKE_CXX_FLAGS="-DROCKET_${BUG_ID}" \
            -G Ninja && \
        cmake --build /opt/rippled-build --parallel "$(nproc)" && \
        install -D /opt/rippled-build/rippled /opt/rippled-artifacts/rippled'


FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# 将之前构建好的rippled拷贝过来
COPY --from=builder /opt/rippled-artifacts/rippled /usr/local/bin/rippled

# 拷贝config文件等，准备运行
RUN mkdir -p /opt/ripple/etc
COPY rippled_default_2.6.0.cfg /opt/ripple/etc/rippled.cfg
COPY validators_default_2.6.0.txt /opt/ripple/etc/validators.txt

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /usr/local/bin/rippled /entrypoint.sh

RUN mkdir -p /config/db /var/lib/rippled/db /var/log/rippled

WORKDIR /config

ENTRYPOINT ["/entrypoint.sh"]
CMD []


# docker自定义健康检查，每30秒检查一次，超时时间10秒，启动后60秒才开始检查，检查命令是curl访问本地5005端口，如果失败就返回1，成功返回0
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD curl -f http://localhost:5005 || exit 1
