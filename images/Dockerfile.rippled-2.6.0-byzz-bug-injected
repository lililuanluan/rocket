# rippled 2.6.0 + ByzzFuzz Bug (getTrustedForLedger) 从源码编译
# 使用 Conan 2 + CMake 构建系统
# 
# 该Dockerfile基于2.6.0版本，但注入了getTrustedForLedger()的bug
# 用于在ByzzFuzz测试下重现bug行为
#
# Bug说明：
# - 原始bug在PR #4424中被修复（https://github.com/XRPLF/rippled/pull/4424）
# - 该bug导致getTrustedForLedger()只检查ledger ID，不检查sequence号
# - 这可能导致返回来自不同sequence号的验证数据，违反Byzantine共识
# - 该Dockerfile通过反向应用PR #4424的修复来注入bug

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# 安装构建依赖
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    gcc-12 \
    g++-12 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100

# 安装 Conan 2
RUN pip3 install conan

# The build command supplies a clean worktree at
# ``--build-context rippled-src=...``. Keeping it as a named context avoids
# depending on images/.dockerignore, which deliberately excludes rippled.
WORKDIR /opt
COPY --from=rippled-src . ./rippled

WORKDIR /opt/rippled

# 配置 Conan profile
RUN conan profile detect \
    && sed -i 's|^compiler\.cppstd=.*$|compiler.cppstd=20|' $(conan config home)/profiles/default \
    && sed -i 's|^compiler\.libcxx=.*$|compiler.libcxx=libstdc++11|' $(conan config home)/profiles/default

# 添加 XRPL Conan remote（获取 patched recipes）
RUN conan remote add --index 0 xrplf "https://conan.ripplex.io" || true

# 创建构建目录并安装依赖（并行构建依赖）
RUN mkdir -p .build && cd .build \
    && conan install .. --output-folder . --build missing --settings build_type=Release \
       -c tools.build:jobs=$(nproc)

# 使用 CMake 配置和构建（最大并行）
RUN cd .build \
    && cmake -DCMAKE_TOOLCHAIN_FILE:FILEPATH=build/generators/conan_toolchain.cmake \
             -DCMAKE_BUILD_TYPE=Release \
             -Dxrpld=ON \
             -Dtests=OFF \
             -G Ninja \
             .. \
    && cmake --build . --parallel

# ============ 最终镜像 ============
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
LABEL org.rocket.byzzfuzz_database_path_wrapper="1"

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    curl \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# 从构建阶段复制 rippled 二进制文件
COPY --from=builder /opt/rippled/.build/rippled /usr/local/bin/rippled

# 复制默认配置文件（当 /config/ 下文件不存在时使用）
RUN mkdir -p /opt/ripple/etc
COPY rippled_default_2.6.0.cfg /opt/ripple/etc/rippled.cfg
COPY validators_default_2.6.0.txt /opt/ripple/etc/validators.txt

# 复制 entrypoint。2.6.0 需要一个小 wrapper 来兼容 Rocket 运行时
# 生成的精简 rippled.cfg。
COPY entrypoint.sh /entrypoint.base.sh
COPY entrypoint_2.6.0.sh /entrypoint.sh
RUN chmod +x /usr/local/bin/rippled /entrypoint.base.sh /entrypoint.sh

# 创建持久化目录
RUN mkdir -p /config/db /var/lib/rippled/db /var/log/rippled

WORKDIR /config

# 持久化目录
VOLUME ["/config/db", "/var/lib/rippled/db", "/var/log/rippled"]

ENTRYPOINT ["/entrypoint.sh"]
CMD []

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD curl -f http://localhost:5005 || exit 1 || true
